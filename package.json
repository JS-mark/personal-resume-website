{
  "name": "personal-resume-website",
  "version": "0.0.1",
  "private": true,
  "description": "暗黑赛博朋克风格的个人简历站点 + Remotion 视频展示",
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter web dev",
    "dev:remotion": "pnpm --filter @resume/remotion dev",
    "build": "turbo run build",
    "render": "pnpm --filter @resume/remotion render",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo clean && rm -rf node_modules",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.6",
    "eslint": "^10.4.0",
    "turbo": "^2.9.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.23.0",
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  }
}
